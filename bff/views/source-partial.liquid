<div>
    <form>
        <div>
            <label for="uuid">UUID</label>
            <input type="text" disabled id="uuid" name="uuid" value="{{ uuid }}"/>

            <label for="version">Version</label>
            <input type="text" disabled id="version" name="version" value="{{ version }}"/>

            <label for="filename">Filename</label>
            <input type="text" id="filename" name="filename" value="{{ filename }}"/>
        </div>
        <div>
            <label for="filecontent">File content</label>
            <textarea rows="30" columns="80" id="filecontent" name="filecontent">{{ content | escape }}</textarea>
        </div>
    </form>
</div>
